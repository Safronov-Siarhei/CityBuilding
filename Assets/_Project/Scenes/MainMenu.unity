  m_Text: "\u041D\u0430\u0431\u0435\u0433\u0438, \u0441\u043E\u0441\u0435\u0434,
    \u0431\u0435\u0434\u0441\u0442\u0432\u0438\u044F, \u0437\u0430\u043F\u0430\u0441\u044B
    \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0441\u0442\u0440\u043E\u0439\u043A\u0438
    \u2014 \u043A\u0430\u043A \u0442\u0435\u0431\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F."
