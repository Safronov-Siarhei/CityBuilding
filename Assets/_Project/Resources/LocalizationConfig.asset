  - key: '#map_name_archipelago'
    values:
    - "\u0410\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433"
    - Archipelago
  - key: '#map_desc_archipelago'
    values:
    - "\u041C\u043E\u0440\u0435 \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432:
      \u0432\u0430\u0448 \u0434\u043E\u043C \u043D\u0430 \u043E\u0434\u043D\u043E\u043C,
      \u0433\u043B\u0430\u0432\u043D\u0430\u044F \u0431\u0430\u0437\u0430 \u043E\u0440\u043A\u043E\u0432
      \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u043C. \u041A\u0430\u0436\u0434\u0430\u044F
      \u043D\u043E\u0432\u0430\u044F \u0438\u0433\u0440\u0430 \u2014 \u043D\u043E\u0432\u044B\u0439
      \u0430\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433."
    - 'A sea of islands: your home on one, the orcs'' main base on a far one. Every
      new game is a new archipelago.'
  - key: '#sandbox_code_hint'
    values:
    - "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F"
