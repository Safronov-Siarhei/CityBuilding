  - key: '#campaign_soon'
    values:
    - "\u041A\u0430\u043C\u043F\u0430\u043D\u0438\u044F \u0432 \u0440\u0430\u0431\u043E\u0442\u0435:
      \u0443\u0440\u043E\u0432\u043D\u0438 \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F
